# Harness C3 — sdkconfig.defaults (SPEC.md §3). ESP-IDF v5.5, target esp32c3.
# Board: Sunton ESP32-2424S012C / -C-I (see Kconfig "Board" choice).
#
# After editing this file, delete firmware/sdkconfig (or run
# `idf.py reconfigure` from a clean tree): an existing sdkconfig wins over
# these defaults.

# ── target / flash / CPU ────────────────────────────────────────────────────
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# DIO, not QIO: works on every ESP32-C3-MINI-1U / C3FN4 flash variant and is
# what the board vendor ships. The cache makes the difference invisible here.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
# -O2. (The previous "CONFIG_COMPILER_OPTIMIZATION_RELEASE" is not an IDF 5
# symbol: it was silently ignored and the firmware shipped at -Og.)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ── console on the native USB port (shared with the cable protocol) ────────
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ── no radios: the cable is the whole connection ───────────────────────────
CONFIG_BT_ENABLED=n

# ── RTOS ────────────────────────────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000
# Task watchdog: panic after 10 s — a wedged UI task (it subscribes itself)
# must reboot the dial rather than freeze the screen.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y

# ── partition table (dual OTA, see partitions.csv) + real rollback ─────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Without this, esp_ota_mark_app_valid_cancel_rollback() in app_main was a
# no-op: a future OTA image that crashes at boot would never be rolled back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ── LVGL v9.2 (registry component lvgl/lvgl==9.2.2, keys from its Kconfig) ──
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_BUILTIN_MALLOC=y
# 48 KB pool (9.2 counts in KILOBYTES; "LV_MEM_SIZE" does not exist there).
CONFIG_LV_MEM_SIZE_KILOBYTES=48
# LVGL is driven from exactly one task (ui.c) under display_lock(): no LVGL OS
# layer, hence no extra SW-render thread (8 KB stack) on a single-core chip.
CONFIG_LV_OS_NONE=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_THEME_DEFAULT_DARK=y
# The UI uses its own fonts (main/fonts: Latin-1 + French punctuation + λ +
# LV_SYMBOL_*). Montserrat 14 stays only as LVGL's theme default.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_USE_ASSERT_MALLOC=y
# Lamp mode: the radial glow is a complex gradient.
CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=y
CONFIG_LV_GRADIENT_MAX_STOPS=3

# ── panel scan direction ───────────────────────────────────────────────────
# Unit Silexperience (Sunton 2424S012C, GC9A01 batch of 2026-09). Measured on
# the device: the picture is mirrored when the driver's native scan direction
# is left untouched, so the mirror is needed — the Kconfig defaults are right
# for the PANEL. They are wrong for the TOUCH though (mirror X off by default):
# that mismatch drew the UI correctly while sending every tap to the mirrored
# side. Both are therefore pinned explicitly, so the two halves of the same
# glass can never disagree.
CONFIG_HARNESS_LCD_MIRROR_X=y
CONFIG_HARNESS_TOUCH_MIRROR_X=y
